[Unit]
Description=Popup every 10 minutes from 09:00 to 10:30 when OTC quota exceeds 500

[Timer]
OnCalendar=Mon-Fri *-*-* 09:00/10
OnCalendar=Mon-Fri *-*-* 10:00
OnCalendar=Mon-Fri *-*-* 10:10
OnCalendar=Mon-Fri *-*-* 10:20
OnCalendar=Mon-Fri *-*-* 10:30
Persistent=true
AccuracySec=15s

[Install]
WantedBy=timers.target
